{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-kol",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // Probe security relies on workers.dev global fetch only: no origin/VPC/private-network bindings. DNS preflight alone does not prevent rebinding.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true, "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } }, "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PROBE_ALLOWED_URLS": "https://jsonplaceholder.typicode.com/todos/1,https://jsonplaceholder.typicode.com/posts/1", "REVIEW_PRICE": "5", "PAYMENT_WINDOW_SECONDS": "180", "ALLOW_AGGREGATE_PAYMENTS": "false",
    "PAY_TO": "p_umBqZvkim8"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-kol",
      "database_id": "6789f92e-e3d5-4906-a756-6edc31b21eed",
      "migrations_dir": "migrations"
    }
  ]
}
